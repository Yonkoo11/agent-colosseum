# Agent Colosseum Configuration
# Copy to .env and fill in values

# Anthropic API key (required for live AI mode, omit for demo simulation)
ANTHROPIC_API_KEY=sk-ant-...

# Wallet private key (suiprivkey bech32 or base64 Ed25519, required for on-chain trading)
# Get from: one keytool export --key-identity <address> --json
PRIVATE_KEY=

# Contract addresses (defaults loaded from scripts/deployed.json)
# AMM_PACKAGE_ID=0xf5b9c384661a84b5a9ae339a4eadfea085886e33256be4d2ff722b0a2c8392b7
# COLOSSEUM_PACKAGE_ID=0x5a4d979fd8374529f432ca846b7d91371722a439bb8215720538c13a3df87c2f
# POOL_ID=0x79022dd6d0f9b9008e56ae55ca8edcd7b4f06f675d6215090b060eb55aeedecc
# ARENA_ID=0xf9830ccbce88ce83198b6bd36fe50fb2b6ac102d1b2ea07b8fa61df74264a813

# Competition settings
ROUNDS=5
