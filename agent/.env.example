# Agent Colosseum — Environment Variables
# Copy to .env and fill in real values

# AI provider (Anthropic Claude for tool-calling agents)
ANTHROPIC_API_KEY=sk-ant-...

# Per-agent wallets (base64-encoded Ed25519 secret keys)
# Each agent needs its own wallet to sign transactions independently.
# Generate with: one client new-address ed25519
# Export with: one keytool export --key-identity <address>
AGENT_0_KEY=base64-encoded-secret-key-for-momentum-bot
AGENT_1_KEY=base64-encoded-secret-key-for-mean-reversion-bot
AGENT_2_KEY=base64-encoded-secret-key-for-market-maker-bot

# Fallback: single shared wallet (used if per-agent keys not set)
# PRIVATE_KEY=base64-encoded-ed25519-secret-key
# MNEMONIC=word1 word2 word3 ...

# On-chain object IDs (defaults loaded from scripts/deployed.json)
AMM_PACKAGE_ID=0xf5b9c384661a84b5a9ae339a4eadfea085886e33256be4d2ff722b0a2c8392b7
COLOSSEUM_PACKAGE_ID=0x5a4d979fd8374529f432ca846b7d91371722a439bb8215720538c13a3df87c2f
POOL_ID=0x79022dd6d0f9b9008e56ae55ca8edcd7b4f06f675d6215090b060eb55aeedecc
ARENA_ID=0xf9830ccbce88ce83198b6bd36fe50fb2b6ac102d1b2ea07b8fa61df74264a813

# Competition settings
ROUNDS=5
